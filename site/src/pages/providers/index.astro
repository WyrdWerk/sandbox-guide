---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { providers } from "../../lib/data";
---

<Base title="Providers" description="One page per provider: what it is, sizes, billing, usability, caveats and sources.">
  <PageHeader
    kicker="Providers"
    title={`The ${providers.length} providers`}
    standfirst="These pages are secondary: the feature pages carry the comparison. Use these for the detail behind a verdict — sizes, the meter, how far a non-technical user gets, and every contradiction the research found."
  />

  <div class="wrap">
    <section class="section section--flush">
      <div class="picks">
        {
          providers.map((provider) => (
            <article class="pick">
              <span class="pick__label">{provider.kind === "vps" ? "VPS · " : ""}{provider.checkedOn ? `Checked ${provider.checkedOn}` : "Research pending"}</span>
              <h3 class="pick__title"><a href={`/providers/${provider.id}/`}>{provider.name}</a></h3>
              <p class="pick__body">{provider.oneLiner}</p>
              <p class="pick__catch">
                {provider.caveats.length} recorded {provider.caveats.length === 1 ? "caveat" : "caveats"}.
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Base>
