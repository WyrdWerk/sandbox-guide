---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CostCard from "../../components/CostCard.astro";
import { providers } from "../../lib/data";

export function getStaticPaths() {
  return providers.map((provider) => ({ params: { id: provider.id }, props: { provider } }));
}

const { provider } = Astro.props;
const statusLabel = {
  open: "Open question",
  rechecking: "Needs re-checking",
  contradiction: "Contradiction",
};
---

<Base title={provider.name} description={provider.oneLiner}>
  <PageHeader
    kicker={`Provider · checked ${provider.checkedOn ?? "pending"}`}
    title={provider.name}
    standfirst={provider.oneLiner}
    meta={[provider.url.replace("https://", ""), "12 providers", "Sources linked"]}
  />

  <div class="wrap">
    <section class="section section--flush">
      <div class="prose">
        {provider.whatItIs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <h2 class="section__title">At a glance</h2>
      <table class="data-table">
        <tbody>
          <tr><th scope="row">Who it is for</th><td>{provider.whoFor}</td></tr>
          <tr><th scope="row">Isolation</th><td>{provider.isolation}</td></tr>
          <tr><th scope="row">Sizes</th><td>{provider.sizes}</td></tr>
        </tbody>
      </table>

      <h2 class="section__title">How it bills</h2>
      <table class="data-table">
        <tbody>
          <tr><th scope="row">Model</th><td>{provider.billing.model}</td></tr>
          <tr><th scope="row">Meter</th><td>{provider.billing.meter}</td></tr>
          <tr><th scope="row">While stopped</th><td>{provider.billing.stopped}</td></tr>
          <tr><th scope="row">Plan fee</th><td>{provider.billing.planFee}</td></tr>
          <tr><th scope="row">Minimum</th><td>{provider.billing.minimum}</td></tr>
        </tbody>
      </table>
      <p class="section__note">
        How {provider.name} lets you try before paying is on{" "}
        <a href="/features/trials-free-tiers/">Trials and free tiers</a>.
      </p>

      <h2 class="section__title">Where it stands out</h2>
      <ul class="prose">
        {provider.strengths.map((strength) => <li>{strength}</li>)}
      </ul>

      <h2 class="section__title">Using it without writing code</h2>
      <table class="data-table">
        <tbody>
          <tr><th scope="row">Dashboard</th><td>{provider.usability.dashboard}</td></tr>
          <tr><th scope="row">Without code</th><td>{provider.usability.withoutCode}</td></tr>
          <tr><th scope="row">Signup</th><td>{provider.usability.signup}</td></tr>
          <tr><th scope="row">Docs and support</th><td>{provider.usability.docs}</td></tr>
        </tbody>
      </table>

      <h2 class="section__title">Caveats and contradictions</h2>
      <p class="section__note">
        Shown as the research found them. A contradiction means the provider's own pages disagree;
        an open question means the answer is not published.
      </p>
      <ol class="watch">
        {provider.caveats.map((caveat, index) => (
          <li class="watch__item">
            <span class="watch__index">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="watch__title">
              {caveat.issue} <span class="tag tag--not-published">{statusLabel[caveat.status]}</span>
            </h3>
            <p class="watch__body">{caveat.detail}</p>
          </li>
        ))}
      </ol>

      <h2 class="section__title">Sources</h2>
      <ul class="sources__list">
        {provider.sources.map((source) => (
          <li><a href={source.url} rel="noreferrer noopener">{source.label}</a></li>
        ))}
      </ul>
    </section>

    {
      provider.cost && (
        <section class="section" aria-labelledby="costs-h">
          <div class="section__head">
            <h2 class="section__title" id="costs-h">The three shared workloads</h2>
            <p class="section__note">List-price illustrations, not quotes</p>
          </div>
          <div class="cost-grid">
            <CostCard label="A" title="1,000 short tasks" cost={provider.cost.A} />
            <CostCard label="B" title="One always-on box" cost={provider.cost.B} />
            <CostCard label="C" title="Three hours a day" cost={provider.cost.C} />
          </div>
        </section>
      )
    }
  </div>
</Base>
