---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CostCard from "../../components/CostCard.astro";
import CompanyFacts from "../../components/CompanyFacts.astro";
import Quote from "../../components/Quote.astro";
import SectionNav from "../../components/SectionNav.astro";
import Badge from "../../components/Badge.astro";
import { providers, pricing, useCases, engineCase, features, capabilitiesOf, capabilityLabel, formatDate } from "../../lib/data";
import { price, presets, formatMoney } from "../../lib/cost";
import { providerAnswer } from "../../lib/agents";

export function getStaticPaths() {
  return providers.map((provider) => ({ params: { id: provider.id }, props: { provider } }));
}

const { provider } = Astro.props;
const card = pricing.find((c) => c.provider === provider.id);
// What this provider is recommended for, taken from the use-case guides' own picks.
const goodFor = useCases.flatMap((u) =>
  u.picks.filter((p) => p.provider === provider.id).map((p) => ({ useCase: u, pick: p })),
);
const personal = card ? price(card, presets.personal.workload) : undefined;
// Every capability, grouped by feature, with this provider's verdict and catch.
const checklist = features
  .map((f) => ({ f, items: capabilitiesOf(f.id).map((c) => ({ c, row: c.rows.find((r) => r.provider === provider.id) })) }))
  .filter((g) => g.items.length);
const nav = [
  { href: "#about", label: "What it is" },
  { href: "#glance", label: "At a glance" },
  { href: "#fits", label: "Fits" },
  { href: "#billing", label: "Billing" },
  { href: "#strengths", label: "Strengths" },
  { href: "#without-code", label: "Without code" },
  { href: "#checklist", label: "Checklist" },
  { href: "#company", label: "Company" },
  { href: "#caveats", label: "Caveats" },
  { href: "#sources", label: "Sources" },
  ...(card ? [{ href: "#costs", label: "Costs" }] : []),
];
const statusLabel = {
  open: "Open question",
  rechecking: "Needs re-checking",
  contradiction: "Contradiction",
};
---

<Base title={provider.status === "researched" ? `${provider.name} pricing, limits and catches` : provider.name} description={provider.oneLiner} markdown={`/data/providers/${provider.id}.md`} modified={card?.checkedOn ?? provider.checkedOn}>
  <PageHeader
    parent={{ href: "/providers/", label: "Providers" }}
    kicker={`Checked ${provider.checkedOn ?? "pending"}`}
    title={provider.name}
    standfirst={provider.oneLiner}
    answer={providerAnswer(provider)}
    meta={[provider.url.replace("https://", ""), `${providers.length} providers`, "Sources linked"]}
  />

  <SectionNav items={nav} />

  <div class="wrap">
    <section class="section section--flush" id="about">
      <div class="prose">
        {provider.whatItIs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <h2 class="section__title" id="glance">At a glance</h2>
      <table class="data-table">
        <tbody>
          <tr><th scope="row">Who it is for</th><td>{provider.whoFor}</td></tr>
          <tr><th scope="row">Isolation</th><td>{provider.isolation}</td></tr>
          <tr><th scope="row">Sizes</th><td>{provider.sizes}</td></tr>
          {personal && (
            <tr>
              <th scope="row">A personal agent here</th>
              <td>
                About {formatMoney(personal.total)} a month for one always-on 2 vCPU / 4 GiB machine ({personal.shape}),
                before the AI model.{" "}
                {!personal.feasible && <strong>The catch: {personal.problems.join(" ")}</strong>}{" "}
                <a href={`/costs/?preset=personal`}>Change the numbers</a>
              </td>
            </tr>
          )}
          <tr>
            <th scope="row">Recommended in</th>
            <td>
              {goodFor.length ? (
                <ul class="plain-list">
                  {goodFor.map(({ useCase, pick }) => (
                    <li><a href={`/use-cases/${useCase.id}/`}>{useCase.title}</a>: {pick.for.charAt(0).toLowerCase() + pick.for.slice(1)}</li>
                  ))}
                </ul>
              ) : (
                <>Not one of the picks in any <a href="/use-cases/">use-case guide</a>.</>
              )}
            </td>
          </tr>
        </tbody>
      </table>

      <h2 class="section__title" id="fits">Fits well, fits badly</h2>
      <p class="section__note">
        Our reading of the sourced material on this page, not a provider claim.
      </p>
      <div class="fits">
        <div class="fits__side fits__side--well">
          <h3 class="fits__title">Fits well</h3>
          <ul class="fits__list">
            {provider.fits.well.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="fits__side fits__side--badly">
          <h3 class="fits__title">Fits badly</h3>
          <ul class="fits__list">
            {provider.fits.badly.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <h2 class="section__title" id="billing">How it bills</h2>
      <table class="data-table">
        <tbody>
          <tr><th scope="row">Model</th><td>{provider.billing.model}</td></tr>
          <tr><th scope="row">Meter</th><td>{provider.billing.meter}</td></tr>
          <tr><th scope="row">While stopped</th><td>{provider.billing.stopped}</td></tr>
          <tr><th scope="row">Plan fee</th><td>{provider.billing.planFee}</td></tr>
          <tr><th scope="row">Minimum</th><td>{provider.billing.minimum}</td></tr>
        </tbody>
      </table>
      <p class="section__note">
        How {provider.name} lets you try before paying is on{" "}
        <a href="/features/trials-free-tiers/">Trials and free tiers</a>.
      </p>

      <h2 class="section__title" id="strengths">Where it stands out</h2>
      <ul class="prose">
        {provider.strengths.map((strength) => <li>{strength}</li>)}
      </ul>

      <h2 class="section__title" id="without-code">Using it without writing code</h2>
      <table class="data-table">
        <tbody>
          <tr><th scope="row">Dashboard</th><td>{provider.usability.dashboard}</td></tr>
          <tr><th scope="row">Without code</th><td>{provider.usability.withoutCode}</td></tr>
          <tr><th scope="row">Signup</th><td>{provider.usability.signup}</td></tr>
          <tr><th scope="row">Docs and support</th><td>{provider.usability.docs}</td></tr>
        </tbody>
      </table>

      <h2 class="section__title" id="checklist">Capability checklist</h2>
      <p class="section__note">Every capability the guide checks, with the catch where {provider.name}'s version falls short. <a href="/capabilities/">Compare all providers</a></p>
      <div class="related">
        {checklist.map(({ f, items }) => (
          <div>
            <h3><a href={`/features/${f.id}/`}>{f.navTitle}</a></h3>
            <ul class="plain-list">
              {items.map(({ c, row }) => (
                <li>
                  <a href={`/capabilities/${c.id}/#${provider.id}`}>{c.title}</a>{" "}
                  {row ? <Badge verdict={row.verdict} label={capabilityLabel[row.verdict]} /> : <Badge verdict="pending" />}
                  {row?.verdict === "partly" && row.shortfall && <span class="muted"> {row.shortfall}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <h2 class="section__title" id="company">The company</h2>
      <p class="section__note">
        From the profile's company section: the legal entity, who funds it, and what a buyer can
        check before signing.
      </p>
      <CompanyFacts facts={provider.company.facts} />

      <h2 class="section__title" id="caveats">Caveats and contradictions</h2>
      <p class="section__note">
        Shown as the research found them. A contradiction means the provider's own pages disagree;
        an open question means the answer is not published.
      </p>
      <ol class="watch">
        {provider.caveats.map((caveat, index) => (
          <li class="watch__item">
            <span class="watch__index">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="watch__title">
              {caveat.issue} <span class="tag tag--not-published">{statusLabel[caveat.status]}</span>
            </h3>
            <p class="watch__body">{caveat.detail}</p>
            {caveat.evidence && (
              <div class="evidence">
                {caveat.evidence.map((source) => (
                  <Quote
                    text={source.quote}
                    cite={provider.name}
                    url={source.url}
                    tag={source.confidence}
                  />
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>

      <h2 class="section__title" id="sources">Sources</h2>
      <ul class="sources__list">
        {provider.sources.map((source) => (
          <li><a href={source.url} rel="noreferrer noopener">{source.label}</a></li>
        ))}
      </ul>
    </section>

    {
      card && (
        <section class="section" id="costs" aria-labelledby="costs-h">
          <div class="section__head">
            <h2 class="section__title" id="costs-h">The three shared workloads</h2>
            <p class="section__note">List-price illustrations from the <a href="/costs/">calculator</a>, not quotes. Prices checked {formatDate(card.checkedOn)}.</p>
          </div>
          <div class="cost-grid">
            <CostCard label="A" title="1,000 short tasks" cost={engineCase(provider.id, "a")} />
            <CostCard label="B" title="One always-on box" cost={engineCase(provider.id, "b")} />
            <CostCard label="C" title="Three hours a day" cost={engineCase(provider.id, "c")} />
          </div>
        </section>
      )
    }
  </div>
</Base>
