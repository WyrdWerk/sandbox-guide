---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { providerById } from "../../lib/data";
import { comparisons, pairSlug } from "../../lib/agents";
const name = (id: string) => providerById.get(id)!.name;
---

<Base title="Compare" description="Compare every provider head to head on features and cost, by situation, or against list-price illustrations.">
  <PageHeader
    kicker="Compare"
    title="Three ways to compare"
    standfirst="Price matters only once a provider can do the job. The tables compare what each provider does across the sixteen features, the situations put that in the context of a job, and the costs show what your workload would cost."
  />

  <div class="wrap">
    <section class="section section--flush">
      <div class="picks">
        <article class="pick">
          <span class="pick__label">01</span>
          <h3 class="pick__title"><a href="/compare/side-by-side/">Side by side</a></h3>
          <p class="pick__body">
            Pick two or three providers and read them head to head across all sixteen features,
            then priced for a workload you choose.
          </p>
          <p class="pick__catch">Three is the maximum; more columns stop being scannable.</p>
        </article>
        <article class="pick">
          <span class="pick__label">02</span>
          <h3 class="pick__title"><a href="/compare/situations/">By situation</a></h3>
          <p class="pick__body">
            Eight jobs, from a browser agent to EU data residency, with the features each one
            depends on and two or three providers worth a look.
          </p>
          <p class="pick__catch">A provider that fits one situation can be wrong for the next.</p>
        </article>
        <article class="pick">
          <span class="pick__label">03</span>
          <h3 class="pick__title"><a href="/compare/reference-costs/">Reference costs</a></h3>
          <p class="pick__body">
            The same three workloads priced at list rates, with the arithmetic shown and every
            substitution named.
          </p>
          <p class="pick__catch">
            Illustrations, not quotes. For your own numbers, use the <a href="/costs/">cost calculator</a>.
          </p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="pairs-h">
      <div class="section__head">
        <h2 class="section__title" id="pairs-h">Common head-to-heads</h2>
        <p class="section__note">The providers people search for most, compared on cost, features and capabilities</p>
      </div>
      <ul class="fits__list">
        {comparisons.pairs.map(([a, b]) => <li><a href={`/compare/${pairSlug(a, b)}/`}>{name(a)} vs {name(b)}</a></li>)}
        <li><a href="/compare/hermes-vs-openclaw/">Hermes agent vs OpenClaw</a> (the agents themselves)</li>
        {comparisons.alternatives.map((id) => <li><a href={`/providers/${id}/alternatives/`}>Alternatives to {name(id)}</a></li>)}
      </ul>
    </section>
  </div>
</Base>
