---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CostCard from "../../components/CostCard.astro";
import SectionNav from "../../components/SectionNav.astro";
import { providers, engineCase as card } from "../../lib/data";

const researched = providers.filter((provider) => provider.status === "researched");

const nav = [
  { href: "#workloads", label: "The workloads" },
  ...researched.map((provider) => ({ href: `#cost-${provider.id}`, label: provider.name })),
];
---

<Base title="Reference costs" description="Three shared workloads priced from list rates, as illustrations rather than quotes.">
  <PageHeader
    parent={{ href: "/compare/", label: "Compare" }}
    kicker="Reference costs"
    title="Three workloads, priced at list rates"
    standfirst="A reference point, not a quote. The arithmetic is shown so you can redo it when prices change, and every substituted size is named. For your own workload, use the cost calculator."
    meta={[`${researched.length} providers`, "List prices checked 29 October 2026", "Illustrations, not quotes"]}
  />

  <SectionNav items={nav} />

  <div class="wrap">
    <section class="section section--flush" id="workloads">
      <div class="section__head">
        <h2 class="section__title">The three shared workloads</h2>
        <p class="section__note">
          A — 1,000 ten-minute tasks a month, 2 vCPU / 4 GiB, deleted after each, CPU working half the time.<br />
          B — one always-on 4 vCPU / 8 GiB / 50 GiB box for a month, CPU working 10% of the time.<br />
          C — one 2 vCPU / 4 GiB / 20 GiB box, three hours a day, stopped otherwise with its files kept.
        </p>
      </div>
      <p class="prose">
        Where a provider does not sell the exact shape, the cheapest size that fits is used and named in the card.
        Model tokens, taxes and anything the provider does not price are excluded. Providers that bill CPU only
        while it works are priced at the CPU share stated above, so a busier workload costs more on those.
      </p>
      <p class="section__note">
        These are illustrations from published list rates, not invoices. Every card is produced by the
        same engine as the <a href="/costs/?preset=a">cost calculator</a>, from rates re-checked on 29 October,
        and the engine is tested against the same workloads worked by hand. <a href="/costs/how-it-works/">How the
        costs are calculated</a>.
      </p>
    </section>

    {
      researched.map((provider) => (
        <section class="section" aria-labelledby={`cost-${provider.id}`}>
          <div class="section__head">
            <h2 class="section__title" id={`cost-${provider.id}`}>
              <a href={`/providers/${provider.id}/`}>{provider.name}</a>
            </h2>
            <p class="section__note">{provider.billing.model}</p>
          </div>
          <div class="cost-grid">
            <CostCard label="A" title="1,000 short tasks" cost={card(provider.id, "a")} />
            <CostCard label="B" title="One always-on box" cost={card(provider.id, "b")} />
            <CostCard label="C" title="Three hours a day" cost={card(provider.id, "c")} />
          </div>
        </section>
      ))
    }
  </div>
</Base>
