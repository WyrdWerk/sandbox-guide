---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { features, groups } from "../../lib/data";
---

<Base title="Features" description="Sixteen features that decide whether a sandbox fits, grouped from the machine to the company.">
  <PageHeader
    kicker="Features"
    title="Sixteen features, one connected argument each"
    standfirst="Each page starts with the idea, shows where providers split with quoted examples, walks one concrete case through every provider, names what to watch for, and compares all twelve with the number that decides each row. It ends with the questions the documentation does not answer."
  />

  <div class="wrap">
    {
      groups.map((group) => (
        <section class="section" aria-labelledby={`group-${group.id}`}>
          <div class="section__head">
            <h2 class="section__title" id={`group-${group.id}`}>{group.title}</h2>
            <p class="section__note">{group.intro}</p>
          </div>
          <div class="picks">
            {features
              .filter((feature) => feature.group === group.id)
              .map((feature) => (
                <article class="pick">
                  <span class="pick__label">{String(feature.order).padStart(2, "0")}</span>
                  <h3 class="pick__title"><a href={`/features/${feature.id}/`}>{feature.title}</a></h3>
                  <p class="pick__body">{feature.standfirst}</p>
                </article>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
