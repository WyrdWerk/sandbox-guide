---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import SectionNav from "../../components/SectionNav.astro";
import SplitList from "../../components/SplitList.astro";
import WatchList from "../../components/WatchList.astro";
import CompareTable from "../../components/CompareTable.astro";
import Scenario from "../../components/Scenario.astro";
import QuestionList from "../../components/QuestionList.astro";
import FeatureCosts from "../../components/FeatureCosts.astro";
import CapabilityMatrix from "../../components/CapabilityMatrix.astro";
import Related from "../../components/Related.astro";
import FeatureFaq from "../../components/FeatureFaq.astro";
import { capabilitiesOf, features, groups, providers } from "../../lib/data";

export function getStaticPaths() {
  return features.map((feature) => ({ params: { id: feature.id }, props: { feature } }));
}

const { feature } = Astro.props;
const group = groups.find((item) => item.id === feature.group);
const position = features.indexOf(feature);
const previous = features[position - 1];
const next = features[position + 1];
const caps = capabilitiesOf(feature.id);
const costed = ["storage", "outbound-network", "billing-models", "trials-free-tiers"].includes(feature.id);
const nav = [
  { href: "#idea", label: "The idea" },
  { href: "#split", label: "Where providers split" },
  { href: "#scenario", label: "One worked case" },
  { href: "#watch", label: "What to watch for" },
  { href: "#compare", label: "Compare all" },
  ...(caps.length ? [{ href: "#capabilities", label: "Capabilities" }] : []),
  ...(costed ? [{ href: "#costs", label: "What it costs" }] : []),
  { href: "#questions", label: "Questions to ask" },
  ...(caps.length ? [{ href: "#faq", label: "Common questions" }] : []),
  { href: "#related", label: "Related" },
];
---

<Base title={feature.title} description={feature.standfirst}>
  <PageHeader
    parent={{ href: "/features/", label: "Features" }}
    kicker={group?.title ?? "Feature"}
    title={feature.title}
    standfirst={feature.standfirst}
  />

  <SectionNav items={nav} />

  <div class="wrap">
    <section class="section section--flush" id="idea" aria-labelledby="idea-h">
      <div class="section__head">
        <h2 class="section__title" id="idea-h">The idea</h2>
      </div>
      <div class="prose">
        {feature.idea.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section" id="split" aria-labelledby="split-h">
      <div class="section__head">
        <h2 class="section__title" id="split-h">Where providers split</h2>
        <p class="section__note">The claim on the left, the provider's own words on the right</p>
      </div>
      <SplitList splits={feature.splits} />
    </section>

    <section class="section" id="scenario" aria-labelledby="scenario-h">
      <div class="section__head">
        <h2 class="section__title" id="scenario-h">One worked case</h2>
        <p class="section__note">The same job at every provider, from the documented defaults</p>
      </div>
      <Scenario scenario={feature.scenario} rows={feature.rows} />
    </section>

    <section class="section" id="watch" aria-labelledby="watch-h">
      <div class="section__head">
        <h2 class="section__title" id="watch-h">What to watch for</h2>
        <p class="section__note">The details that decide the answer in practice</p>
      </div>
      <WatchList items={feature.watchFor} />
    </section>

    <section class="section" id="compare" aria-labelledby="compare-h">
      <div class="section__head">
        <h2 class="section__title" id="compare-h">Compare all {providers.length}</h2>
        <p class="section__note">Docs read 28 October 2026</p>
      </div>
      <CompareTable
        feature={feature.id}
        rows={feature.rows}
        caption={feature.standfirst}
        figureLabel={feature.figureLabel}
      />
    </section>

    {caps.length > 0 && (
      <section class="section" id="capabilities" aria-labelledby="caps-h">
        <div class="section__head">
          <h2 class="section__title" id="caps-h">The specific capabilities</h2>
          <p class="section__note">Each one checked for every provider, with the catch where a version falls short. <a href="/capabilities/">All capabilities</a></p>
        </div>
        <CapabilityMatrix caps={caps} caption={`${feature.navTitle}: capabilities by provider`} />
      </section>
    )}

    <FeatureCosts feature={feature.id} />

    <section class="section" id="questions" aria-labelledby="questions-h">
      <div class="section__head">
        <h2 class="section__title" id="questions-h">Questions to ask before you sign</h2>
        <p class="section__note">Each one targets something the documentation does not answer</p>
      </div>
      <QuestionList questions={feature.questions} />
    </section>

    <FeatureFaq feature={feature.id} />

    <section class="section" id="related" aria-labelledby="related-h">
      <div class="section__head"><h2 class="section__title" id="related-h">Related</h2></div>
      <Related feature={feature.id} self />
    </section>

    <nav class="pager" aria-label="Previous and next feature">
      {previous && (
        <a class="pager__link pager__link--prev" href={`/features/${previous.id}/`} rel="prev">
          <span class="pager__dir">Previous feature</span>
          <span class="pager__title">{previous.title}</span>
        </a>
      )}
      {next && (
        <a class="pager__link pager__link--next" href={`/features/${next.id}/`} rel="next">
          <span class="pager__dir">Next feature</span>
          <span class="pager__title">{next.title}</span>
        </a>
      )}
    </nav>

    <p class="section__note">
      Part of <a href="/features/">{group?.title ?? "Features"}</a>. Next:{" "}
      <a href="/compare/side-by-side/">put two or three providers side by side</a>.
    </p>
  </div>
</Base>
