---
import Base from "../../layouts/Base.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import OfferTable from "../../components/OfferTable.astro";
import CostCase from "../../components/CostCase.astro";
import PickList from "../../components/PickList.astro";
import QuestionList from "../../components/QuestionList.astro";
import { features, providers } from "../../lib/data";

export function getStaticPaths() {
  return features.map((feature) => ({ params: { id: feature.id }, props: { feature } }));
}

const { feature } = Astro.props;
const isBilling = feature.id === "billing";
const isOffer = feature.id === "trying-it-before-you-pay";
const researched = providers.filter((p) => p.status === "researched");
---

<Base title={feature.title} description={feature.standfirst}>
  <header class="page-header">
    <p class="kicker">Feature</p>
    <h1>{feature.title}</h1>
    <p class="standfirst">{feature.standfirst}</p>
  </header>

  <article class="measure">
    {
      feature.concept.map((block) => (
        <section>
          {block.heading && <h2>{block.heading}</h2>}
          {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {block.bullets && (
            <ul>
              {block.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </section>
      ))
    }
  </article>

  <section>
    <h2>How the providers compare</h2>
    <p class="measure">{feature.comparisonIntro}</p>
    {isOffer ? (
      <OfferTable rows={feature.rows} />
    ) : (
      <ComparisonTable rows={feature.rows} caption="Each row links to the provider's own page or documentation." />
    )}
    <p class="note">
      Labels: yes / partly / no / not published. Every note carries a confidence tag and a link to the
      page it came from. See <a href="/how-we-checked/">how we checked</a>.
    </p>
  </section>

  {
    isBilling && (
      <>
        <section>
          <h2>What each provider's meter measures</h2>
          <div class="callout callout-quiet">
            <p class="callout-title">Before you pick a plan</p>
            <p>
              These are paid rates. How each provider lets you try the product first — free plan,
              trial, credit or monthly allowance — is a separate question with its own traps:
              <a href="/features/trying-it-before-you-pay/">trying it before you pay</a>.
            </p>
          </div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Provider</th>
                  <th scope="col">Model</th>
                  <th scope="col">Meter</th>
                  <th scope="col">While stopped</th>
                  <th scope="col">Plan fee</th>
                  <th scope="col">Minimum</th>
                </tr>
              </thead>
              <tbody>
                {researched.map((provider) => (
                  <tr>
                    <th scope="row"><a href={`/providers/${provider.id}/`}>{provider.name}</a></th>
                    <td>{provider.billing.model}</td>
                    <td>{provider.billing.meter}</td>
                    <td>{provider.billing.stopped}</td>
                    <td>{provider.billing.planFee}</td>
                    <td>{provider.billing.minimum}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2>The same three workloads, priced</h2>
          <div class="callout callout-quiet">
            <p class="callout-title">The three shared workloads</p>
            <p>
              <strong>A</strong> — 1,000 agent tasks a month, ten minutes each, on a 2 vCPU / 4 GiB
              machine, deleted after each task.<br />
              <strong>B</strong> — one always-on 4 vCPU / 8 GiB / 50 GiB box for a month.<br />
              <strong>C</strong> — one 2 vCPU / 4 GiB / 20 GiB box used three hours a day for 30 days,
              stopped otherwise.
            </p>
            <p class="note">
              Where a provider does not sell the exact shape, the nearest ones are shown and named.
              Arithmetic is shown so you can redo it when prices change. Model tokens, taxes and
              anything the provider does not price are excluded.
            </p>
          </div>

          {researched.map((provider) => (
            <section>
              <h3><a href={`/providers/${provider.id}/`}>{provider.name}</a></h3>
              {provider.cost && (
                <>
                  <CostCase id="A" title="1,000 short tasks" cost={provider.cost.A} />
                  <CostCase id="B" title="One always-on box" cost={provider.cost.B} />
                  <CostCase id="C" title="Three hours a day" cost={provider.cost.C} />
                </>
              )}
            </section>
          ))}
        </section>
      </>
    )
  }

  <section>
    <h2>Questions to ask any provider</h2>
    <div class="measure">
      <QuestionList questions={feature.questions} />
    </div>
  </section>

  <section>
    <h2>Who to pick, by situation</h2>
    <PickList picks={feature.picks} />
  </section>

  <section class="measure">
    <h2>Traps worth knowing</h2>
    <ul>
      {feature.gotchas.map((gotcha) => <li>{gotcha}</li>)}
    </ul>
  </section>

  <p class="note">
    Back to <a href="/features/">all features</a>, or read the
    <a href="/same-word-different-meaning/">words that change meaning</a> between providers.
  </p>
</Base>
