---
import Base from "../layouts/Base.astro";
import { providerById, useCases } from "../lib/data";
---

<Base title="Use cases" description="Four situations, and who to pick for each: a personal always-on agent, AI-built apps, team workspaces, and browser automation.">
  <header class="page-header">
    <p class="kicker">Use cases</p>
    <h1>Four situations, four different answers</h1>
    <p class="lede">
      There is no overall winner in this market. A provider that is right for a personal agent can be
      wrong for a client workspace, and the other way round. Start here, then check the feature that
      worries you.
    </p>
  </header>

  <nav class="measure" aria-label="Use cases">
    <ul>
      {useCases.map((useCase) => <li><a href={`#${useCase.id}`}>{useCase.title}</a></li>)}
    </ul>
  </nav>

  {useCases.map((useCase) => (
    <section id={useCase.id}>
      <h2>{useCase.title}</h2>
      <p class="standfirst">{useCase.standfirst}</p>

      <h3>What this needs</h3>
      <ul>
        {useCase.needs.map((need) => <li>{need}</li>)}
      </ul>

      <h3>Who to look at</h3>
      <ul class="picks">
        {useCase.picks.map((pick) => {
          const provider = providerById.get(pick.provider);
          return (
            <li>
              <p class="situation">
                <a href={`/providers/${pick.provider}/`}>{provider?.name ?? pick.provider}</a>
              </p>
              <p class="why">{pick.why}</p>
              <p class="note"><strong>Watch for:</strong> {pick.watch}</p>
            </li>
          );
        })}
      </ul>

      <div class="callout callout-warn">
        <p class="callout-title">Why not the others</p>
        <p>{useCase.avoid}</p>
      </div>
    </section>
  ))}

  <p class="note">
    The reasoning behind each pick is on the <a href="/features/">feature pages</a>, with a source for
    every claim. Prices are list prices checked on 28 October 2026.
  </p>
</Base>
