---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import SituationIcon from "../components/SituationIcon.astro";
import { features, groups, providers, situations, useCases, checked, formatDate, pricing, providerName } from "../lib/data";
import { formatMoney, modelCostRange, presets, price } from "../lib/cost";
import modelData from "../data/models.json";

// The headline finding, priced live by the calculator's engine: a personal agent's
// cheapest machine against its model bill across the priced models.
const personal = presets.personal.workload;
const machines = pricing.map((card) => ({ card, q: price(card, personal) })).filter((x) => x.q.feasible).sort((a, b) => a.q.total - b.q.total);
const cheapest = machines[0];
const dearestMachine = machines[machines.length - 1];
const model = modelCostRange(personal, modelData.models)!;
const frontier = model.byKind.frontier!;
const times = (cost: number) => Math.round(cost / cheapest.q.total);
const scale = Math.max(dearestMachine.q.total, model.max.cost);
const bar = (a: number, b: number) => `left: ${(a / scale) * 100}%; width: max(4px, ${((b - a) / scale) * 100}%)`;
const span = (a: number, b: number) => `${formatMoney(a)} – ${formatMoney(b)}`;
---

<Base title={site.title}>
  <div class="wrap">
    <header class="page-header">
      <p class="kicker">{providers.length} providers, {features.length} features</p>
      <h1 class="page-title">What will your agent do?</h1>
      <p class="standfirst">
        Every agent needs a computer to live on: a cloud sandbox, a virtual machine or a plain server.
        The right one follows from the job, not from the hourly rate. Start with what the agent has to
        do, then read the features that decide it.
      </p>
      <p class="hero-actions">
        <a class="button" href="/choose/">Help me choose</a>
        <a class="button button--quiet" href="/do-you-need-a-sandbox/">Do you even need a sandbox?</a>
        <a class="button button--quiet" href="/costs/">Price my own workload</a>
      </p>
      <p class="hero-aside">New to this? Start with whether you need a sandbox at all: a laptop, a plain server and a managed service, priced side by side.</p>
      <p class="page-meta">
        <span class="page-meta__item"><span class="page-meta__dot" aria-hidden="true"></span>{providers.length} providers</span>
        <span class="page-meta__item">Prices checked {formatDate(checked.prices)}</span>
        <span class="page-meta__item">Sources linked</span>
      </p>
    </header>

    <section class="section section--flush" aria-labelledby="finding-h">
      <div class="section__head">
        <h2 class="section__title" id="finding-h">The computer is not your bill. The model is.</h2>
        <p class="section__note">A personal agent that stays on, like OpenClaw or Hermes, priced from list rates</p>
      </div>
      <div class="bill">
        <div class="bill__row">
          <p class="bill__label">Machine</p>
          <p class="bill__figure">{span(cheapest.q.total, dearestMachine.q.total)}</p>
          <div class="bill__track" aria-hidden="true"><span class="bill__bar" style={bar(cheapest.q.total, dearestMachine.q.total)}></span></div>
          <p class="bill__note">A month on the {machines.length} providers that run it as asked: cheapest {providerName(cheapest.card.provider)}, dearest {providerName(dearestMachine.card.provider)}.</p>
        </div>
        <div class="bill__row">
          <p class="bill__label">Model</p>
          <p class="bill__figure">{span(model.min.cost, model.max.cost)}</p>
          <div class="bill__track" aria-hidden="true"><span class="bill__bar" style={bar(model.min.cost, model.max.cost)}></span></div>
          <p class="bill__note">The same month's model, from {model.min.model.label} to {model.max.model.label}; {formatMoney(frontier.low.cost)} or more on any frontier model.</p>
        </div>
      </div>
      <div class="prose">
        <p>
          The cheapest machine that keeps this agent running costs {formatMoney(cheapest.q.total)} a month. On a frontier model,
          its model costs {times(frontier.low.cost)} to {times(frontier.high.cost)} times that. Choosing the model moves the bill
          far more than choosing where the agent lives.
        </p>
      </div>
      <p class="section__note">
          Machine prices checked {formatDate(checked.prices)}. Model prices are the median of hosts that keep no data, from
          TokenWatch, read {modelData.fetchedOn}, at {Math.round(model.millions)} million tokens a month, which is our
          assumption. <a href="/costs/how-it-works/#model-line">How the model line works</a> ·{" "}
          <a href="/costs/">Price your own agent</a>
      </p>
    </section>

    <section class="section" aria-labelledby="usecases-h">
      <div class="section__head">
        <h2 class="section__title" id="usecases-h">Start from what you want to run</h2>
        <p class="section__note">What it needs, how hard it is to set up on each provider, and what it costs</p>
      </div>
      <div class="picks">
        {useCases.map((useCase) => (
          <article class="pick">
            <span class="pick__label">{useCase.kicker}</span>
            <h3 class="pick__title"><a href={`/use-cases/${useCase.id}/`}>{useCase.title}</a></h3>
            <p class="pick__body">“{useCase.question}”</p>
          </article>
        ))}
        <article class="pick">
          <span class="pick__label">Your own numbers</span>
          <h3 class="pick__title"><a href="/costs/">Cost calculator</a></h3>
          <p class="pick__body">Describe the machine and how it runs; every provider is priced with the arithmetic shown.</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="situations-h">
      <div class="section__head">
        <h2 class="section__title" id="situations-h">Pick the situation that sounds like yours</h2>
        <p class="section__note">Each answer names the features that matter and the providers worth a look</p>
      </div>
      <div class="answers">
        {
          situations.map((situation) => (
            <a class="answer" href={`/compare/situations/#${situation.id}`}>
              <SituationIcon name={situation.icon} />
              <span class="answer__title">{situation.title}</span>
              <span class="answer__hint">{situation.question.replace("What will your agent do? ", "")}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="states-h">
      <div class="section__head">
        <h2 class="section__title" id="states-h">Running, paused, stopped</h2>
        <p class="section__note">Three states, and a different part of the machine kept in each</p>
      </div>
      <div class="states">
        <div class="state">
          <span class="state__from">Running</span>
          <span class="state__verb">pause →</span>
          <span class="state__to">
            <span class="state__label">Paused</span>
            <span class="badge badge--yes"><span class="badge__mark" aria-hidden="true"></span>memory if the provider saves RAM</span>
            <span class="badge badge--partly"><span class="badge__mark" aria-hidden="true"></span>still billed</span>
          </span>
        </div>
        <div class="state">
          <span class="state__from">Paused</span>
          <span class="state__verb">stop →</span>
          <span class="state__to">
            <span class="state__label">Stopped</span>
            <span class="badge badge--yes"><span class="badge__mark" aria-hidden="true"></span>files kept</span>
            <span class="badge badge--no"><span class="badge__mark" aria-hidden="true"></span>memory lost</span>
          </span>
        </div>
        <div class="state">
          <span class="state__from">Stopped</span>
          <span class="state__verb">delete →</span>
          <span class="state__to">
            <span class="state__label">Deleted</span>
            <span class="badge badge--no"><span class="badge__mark" aria-hidden="true"></span>disk gone</span>
            <span class="badge badge--unknown"><span class="badge__mark" aria-hidden="true"></span>snapshots may remain</span>
          </span>
        </div>
      </div>
      <p class="section__note">
        Providers disagree about which state is called pause, and two delete the disk on stop.
        The <a href="/features/lifecycle/">lifecycle page</a> has the per-provider detail.
      </p>
    </section>

    {
      groups.map((group) => {
        const groupFeatures = features.filter((feature) => feature.group === group.id);
        return (
          <section class="section" aria-labelledby={`group-${group.id}`}>
            <div class="section__head">
              <h2 class="section__title" id={`group-${group.id}`}>{group.title}</h2>
              <p class="section__note">{group.intro}</p>
            </div>
            <div class="picks">
              {groupFeatures.map((feature) => (
                <article class="pick">
                  <h3 class="pick__title"><a href={`/features/${feature.id}/`}>{feature.title}</a></h3>
                  <p class="pick__body">{feature.standfirst}</p>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }

    <section class="section" aria-labelledby="compare-h">
      <div class="section__head">
        <h2 class="section__title" id="compare-h">Compare head to head</h2>
        <p class="section__note">
          Put two or three providers beside each other across all sixteen features and the cost of
          your workload, or read the list-price illustrations for the three shared workloads.
        </p>
      </div>
      <div class="picks">
        <article class="pick">
          <h3 class="pick__title"><a href="/compare/side-by-side/">Side by side</a></h3>
          <p class="pick__body">Choose two or three providers and read them across the features that decide your case, then what each would cost.</p>
        </article>
        <article class="pick">
          <h3 class="pick__title"><a href="/compare/situations/">By situation</a></h3>
          <p class="pick__body">{situations.length} jobs, the features each one depends on, and the providers worth a look with their catches.</p>
        </article>
        <article class="pick">
          <h3 class="pick__title"><a href="/compare/reference-costs/">Reference costs</a></h3>
          <p class="pick__body">Three shared workloads priced from list rates, as illustrations rather than quotes.</p>
        </article>
        <article class="pick">
          <h3 class="pick__title"><a href="/changes/">What changed recently</a></h3>
          <p class="pick__body">Dated acquisitions, renames and price moves, each with the source and the date it was observed.</p>
        </article>
      </div>
      <p class="section__note">
        For your own workload, use the <a href="/costs/">cost calculator</a>. It shows its arithmetic;{" "}
        <a href="/costs/how-it-works/">here is how it works</a>.
      </p>
    </section>

    <p class="section__note">
      {providers.length} providers documented. Read <a href="/how-we-checked/">how we checked</a>,
      or go straight to the <a href="/providers/">provider pages</a>.
    </p>
  </div>
</Base>
