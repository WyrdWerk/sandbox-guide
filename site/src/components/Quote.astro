---
import type { Confidence } from "../data/schema";
import { plainText } from "../lib/plain";
import { tagClass } from "../lib/data";

interface Props {
  text: string;
  cite: string;
  url: string;
  tag: Confidence;
}

const { text, cite, url, tag } = Astro.props;
---

<figure class="quote">
  <blockquote class="quote__text">“{plainText(text)}”</blockquote>
  <figcaption class="quote__source">
    <cite class="quote__cite">
      <a href={url} rel="noreferrer noopener">{cite}</a>
      {url.includes("battleships.dev") && <span> (battleships.dev, built by the Boat team)</span>}
    </cite>
    <span class={tagClass[tag]}>{tag}</span>
  </figcaption>
</figure>
