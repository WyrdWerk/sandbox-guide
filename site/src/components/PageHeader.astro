---
import site from "../data/site.json";
import { providers } from "../lib/data";

interface Props {
  kicker: string;
  title: string;
  standfirst: string;
  meta?: string[];
  /** The section this page sits in, shown as a link at the start of the kicker. */
  parent?: { href: string; label: string };
}

const { kicker, title, standfirst, meta = [], parent } = Astro.props;
const defaultMeta = [
  `${providers.length} providers`,
  `Every claim dated ${site.checkedOn}`,
  "Sources linked",
];
const items = meta.length > 0 ? meta : defaultMeta;
---

<div class="wrap">
  <header class="page-header">
    <p class="kicker">
      {parent && (
        <>
          <a class="kicker__parent" href={parent.href}>{parent.label}</a>
          <span class="kicker__sep" aria-hidden="true">/</span>
        </>
      )}
      {kicker}
    </p>
    <h1 class="page-title">{title}</h1>
    <p class="standfirst">{standfirst}</p>
    <p class="page-meta">
      {items.map((item, index) => (
        <span class="page-meta__item">
          {index === 0 && <span class="page-meta__dot" aria-hidden="true"></span>}
          {item}
        </span>
      ))}
    </p>
  </header>
</div>
