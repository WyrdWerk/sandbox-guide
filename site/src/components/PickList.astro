---
import type { Pick } from "../data/schema";
import { providerById } from "../lib/data";

interface Props {
  picks: Pick[];
}

const { picks } = Astro.props;
---

<ul class="picks">
  {
    picks.map((pick) => (
      <li>
        <p class="situation">{pick.situation}</p>
        <p class="why">
          {pick.providers.map((id, index) => (
            <>
              {index > 0 ? ", " : ""}
              <a href={`/providers/${id}/`}><strong>{providerById.get(id)?.name ?? id}</strong></a>
            </>
          ))}
          {" — "}
          {pick.why}
        </p>
      </li>
    ))
  }
</ul>
