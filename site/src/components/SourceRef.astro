---
import type { Source } from "../data/schema";

interface Props {
  source?: Source;
}

const { source } = Astro.props;

// Quotes are copied from provider docs, which use Markdown for emphasis and code.
// Strip the markup for display; the wording itself is untouched.
function plainQuote(quote: string): string {
  return quote
    .replace(/\*\*([^*]+)\*\*/g, "$1")
    .replace(/\*([^*]+)\*/g, "$1")
    .replace(/__([^_]+)__/g, "$1")
    .replace(/`/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}
---

{
  source && (
    <span class="source">
      <span class="confidence">{source.confidence}</span>{" "}
      <span class="quote">“{plainQuote(source.quote)}”</span>{" "}
      <a href={source.url} rel="noreferrer noopener" target="_blank">
        source
      </a>
    </span>
  )
}
