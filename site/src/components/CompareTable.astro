---
import type { FeatureRow } from "../data/schema";
import { providerById, tagClass } from "../lib/data";
import Badge from "./Badge.astro";
import Quote from "./Quote.astro";

interface Props {
  rows: FeatureRow[];
  caption: string;
  figureLabel: string;
}

const { rows, caption, figureLabel } = Astro.props;
// Each provider's quote sits in its row behind a one-line summary. It stays in the HTML
// (and in find-in-page); only its display is folded.
---

<table class="compare">
  <caption>{caption}</caption>
  <thead>
    <tr>
      <th scope="col">Provider</th>
      <th scope="col">{figureLabel}</th>
      <th scope="col">Does it?</th>
      <th scope="col">What that means</th>
    </tr>
  </thead>
  {
    rows.map((row) => {
      const provider = providerById.get(row.provider);
      const pending = !provider || provider.status === "pending";
      return (
        <tbody>
          <tr>
            <th scope="row" class="compare__provider">
              {provider ? <a href={`/providers/${provider.id}/`}>{provider.name}</a> : row.provider}
            </th>
            <td data-label={figureLabel} class="compare__figure">
              {pending
                ? "—"
                : row.figure.split("; ").map((part) => <span class="compare__figure-part">{part}</span>)}
            </td>
            <td class="compare__verdict">
              <Badge verdict={pending ? "pending" : row.verdict} />
            </td>
            <td data-label="What that means">
              <span class="compare__note">
                {pending
                  ? "Research pending. No claims are shown until the profile is finished."
                  : row.note}
              </span>
              {!pending && row.source && (
                <details class="compare__source">
                  <summary>
                    <span class="compare__source-label">
                      {provider?.name ?? row.provider}'s own words
                    </span>
                    <span class={`${tagClass[row.source.confidence]} compare__source-tag`}>{row.source.confidence}</span>
                  </summary>
                  <Quote
                    text={row.source.quote}
                    cite={provider?.name ?? row.provider}
                    url={row.source.url}
                    tag={row.source.confidence}
                  />
                </details>
              )}
            </td>
          </tr>
        </tbody>
      );
    })
  }
</table>
