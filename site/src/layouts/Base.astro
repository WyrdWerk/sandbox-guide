---
import "../styles/theme.css";
import site from "../data/site.json";
import { features, providers } from "../lib/data";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const issueUrl = `https://github.com/WyrdWerk/sandbox-guide/issues/new?${new URLSearchParams({
  title: `Correction: ${path}`,
  body: `Page: ${new URL(path, Astro.site)}\n\nWhat is wrong:\n\nWhere the correct information is (a link to the provider's page if you have one):\n`,
})}`;

const nav = [
  { href: "/use-cases/", label: "Use cases" },
  { href: "/features/", label: "Features" },
  { href: "/capabilities/", label: "Capabilities", short: "Can it?" },
  { href: "/compare/", label: "Compare" },
  { href: "/costs/", label: "Costs" },
  { href: "/providers/", label: "Providers" },
  { href: "/changes/", label: "What changed", short: "Changes" },
  { href: "/glossary/", label: "Glossary" },
  { href: "/how-we-checked/", label: "How we checked", short: "Method" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site.title ? title : `${title} — ${site.shortTitle}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem("sg-theme");
        document.documentElement.dataset.theme = t === "dark" ? "dark" : "light";
      } catch (e) {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <rect x="1" y="2" width="18" height="7" rx="1.5" fill="currentColor"></rect>
            <rect x="1" y="11" width="18" height="7" rx="1.5" fill="currentColor" opacity="0.35"></rect>
          </svg>
          Sandbox guide
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.short ? (
                <>
                  <span class="site-nav__full">{item.label}</span>
                  <span class="site-nav__short">{item.short}</span>
                </>
              ) : (
                item.label
              )}
            </a>
          ))}
        </nav>
        <a class="search-link" href="/search/" aria-label="Search the guide" aria-current={isCurrent("/search/") ? "page" : undefined}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
        </a>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="sources">
      <div class="wrap">
        <p class="to-top"><a href="#top">Back to top</a></p>
        <p class="sources__title">About this guide</p>
        <p class="sources__note">
          Checked {site.checkedOn}. Documentation and published prices only; no sandbox was started
          or billed. Every claim carries a source link and a provenance tag.{" "}
          <a href="/how-we-checked/">How we checked</a>. Unfamiliar word? See the <a href="/glossary/">glossary</a>.
        </p>
        <p class="sources__note">
          Spotted a wrong price or an out-of-date claim? <a href={issueUrl} rel="noreferrer noopener">Report something wrong</a>{" "}
          (opens a GitHub issue for this page; needs a free GitHub account).
        </p>
        <p class="sources__note">
          {providers.length} providers, {features.length} features. The cost calculator follows the approach of{" "}
          <a href="https://battleships.dev" rel="noreferrer noopener">battleships.dev</a>, the price-comparison
          dataset built by the Boat team, with thanks; its rates here are re-read from each provider's own pages.{" "}
          <a href="/costs/how-it-works/#battleships">How the two differ</a>.
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var button = document.querySelector("[data-theme-toggle]");
        var root = document.documentElement;
        function label() {
          button.setAttribute(
            "aria-label",
            root.dataset.theme === "light" ? "Switch to dark theme" : "Switch to light theme",
          );
        }
        label();
        button.addEventListener("click", function () {
          var next = root.dataset.theme === "light" ? "dark" : "light";
          root.dataset.theme = next;
          try { localStorage.setItem("sg-theme", next); } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
