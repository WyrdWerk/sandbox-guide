---
import "../styles/theme.css";
import site from "../data/site.json";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const nav = [
  { href: "/features/", label: "Features" },
  { href: "/compare/", label: "Compare" },
  { href: "/providers/", label: "Providers" },
  { href: "/how-we-checked/", label: "How we checked" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site.title ? title : `${title} — ${site.shortTitle}`}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <rect x="1" y="2" width="18" height="7" rx="2" fill="#14624A"></rect>
            <rect x="1" y="11" width="18" height="7" rx="2" fill="#14624A" opacity="0.3"></rect>
          </svg>
          Sandbox guide
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="sources">
      <div class="wrap">
        <p class="sources__title">About this guide</p>
        <p class="sources__note">
          Checked {site.checkedOn}. Documentation and published prices only; no sandbox was started
          or billed. Every claim carries a source link and a provenance tag.{" "}
          <a href="/how-we-checked/">How we checked</a>.
        </p>
        <p class="sources__note">
          Twelve providers, sixteen features. For your own workload pricing, see{" "}
          <a href="https://battleships.dev" rel="noreferrer noopener">battleships.dev</a>, which is
          built by the Boat team and is a price-comparison dataset rather than a guide.
        </p>
      </div>
    </footer>
  </body>
</html>
